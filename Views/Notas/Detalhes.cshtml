@model GerenciadorNotas.Models.Nota

@{
    ViewData["Title"] = "Detalhes";
}

<h1>Detalhes da nota</h1>

<dl class="details">
    <dt>Título</dt>
    <dd>@Model.Titulo</dd>

    <dt>Conteudo</dt>
    <dd>@Model.Conteudo</dd>

    <dt>DataCriacao</dt>
    <dd>@Model.DataCriacao.ToString("dd/MM/yyyy")</dd>
</dl>

<a asp-action="Editar" asp-route-id="@Model.Id" class="button">Editar</a>
<a asp-action="Index" class="button secondary">Voltar</a>
